# Example configuration for connectors and storage
# Copy to .env and fill with real credentials

# Bank connector
BANK_API_URL=https://api.example-bank.com
BANK_API_KEY=your_bank_api_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_API_URL=https://api.sandbox.paypal.com

# SumUp
SUMUP_CLIENT_ID=your_sumup_client_id
SUMUP_CLIENT_SECRET=your_sumup_secret

# Revolut
REVOLUT_TOKEN=your_revolut_token
REVOLUT_ACCOUNT_ID=your_account_id

# SEPA
SEPA_CREDITOR_ID=your_creditor_id
SEPA_BANK_API=https://bank.example/sepa

# Storage paths
DOCUMENT_STORAGE=storage/documents
EINVOICE_PATH=storage/einvoices
