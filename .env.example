# --- Social Media API Keys & Secrets ---
# Facebook Graph API
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token

# Facebook Business API
FACEBOOK_BUSINESS_APP_ID=your-facebook-business-app-id
FACEBOOK_BUSINESS_APP_SECRET=your-facebook-business-app-secret
FACEBOOK_BUSINESS_ACCESS_TOKEN=your-facebook-business-access-token

# Meta Business Suite
META_BUSINESS_CLIENT_ID=your-meta-business-client-id
META_BUSINESS_CLIENT_SECRET=your-meta-business-client-secret
META_BUSINESS_ACCESS_TOKEN=your-meta-business-access-token

# Instagram API
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# Threads API (Meta)
THREADS_CLIENT_ID=your-threads-client-id
THREADS_CLIENT_SECRET=your-threads-client-secret
THREADS_ACCESS_TOKEN=your-threads-access-token

# X (Twitter) API
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_BEARER_TOKEN=your-x-bearer-token

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# TikTok API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# Snapchat API
SNAPCHAT_CLIENT_ID=your-snapchat-client-id
SNAPCHAT_CLIENT_SECRET=your-snapchat-client-secret
SNAPCHAT_ACCESS_TOKEN=your-snapchat-access-token
# Example .env file for OSINT Marketing Tool (production)

# Flask secret key (set to a long, random value in production)
FLASK_SECRET=your-very-secret-key

# PostgreSQL connection string (update with your credentials)
DATABASE_URL=postgresql://youruser:yourpassword@localhost:5432/osint_db

# Multi-tenancy (optional)
# TENANT=autoadmin

# Email configuration (if used)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your@email.com
# EMAIL_PASSWORD=yourpassword


# AI engine selection: gemini, openai, or ollama
AI_ENGINE=gemini

# Gemini API Key (if using Gemini)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key

# Ollama API URL or Key (if using Ollama)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_API_KEY=your-ollama-api-key

# Social posts directory (optional)
# SOCIAL_POSTS_DIR=instance/social_posts

# Document storage
DOCUMENT_STORAGE=storage/documents
EINVOICE_PATH=storage/einvoices

# Open registration (true/false)
OPEN_REGISTRATION=false

# Payment provider (paypal, stripe, etc.)
PAYMENT_PROVIDER=paypal

# Gunicorn/Flask port (default 8000)
PORT=8000
