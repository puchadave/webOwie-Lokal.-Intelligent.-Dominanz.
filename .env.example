# Example .env file for OSINT Marketing Tool (production)

# Flask secret key (set to a long, random value in production)
FLASK_SECRET=your-very-secret-key

# PostgreSQL connection string (update with your credentials)
DATABASE_URL=postgresql://youruser:yourpassword@localhost:5432/osint_db

# Multi-tenancy (optional)
# TENANT=autoadmin

# Email configuration (if used)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your@email.com
# EMAIL_PASSWORD=yourpassword

# AI engine selection: gemini, openai, or ollama
AI_ENGINE=gemini

# Social posts directory (optional)
# SOCIAL_POSTS_DIR=instance/social_posts

# Document storage
DOCUMENT_STORAGE=storage/documents
EINVOICE_PATH=storage/einvoices

# Open registration (true/false)
OPEN_REGISTRATION=false

# Payment provider (paypal, stripe, etc.)
PAYMENT_PROVIDER=paypal

# Gunicorn/Flask port (default 8000)
PORT=8000
