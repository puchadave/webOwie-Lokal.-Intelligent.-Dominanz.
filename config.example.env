# Example configuration for connectors and storage
# Copy to .env and fill with real credentials

# Bank connector
BANK_API_URL=https://api.example-bank.com
BANK_API_KEY=your_bank_api_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_API_URL=https://api.sandbox.paypal.com

# SumUp
SUMUP_CLIENT_ID=your_sumup_client_id
SUMUP_CLIENT_SECRET=your_sumup_secret

# Revolut
REVOLUT_TOKEN=your_revolut_token
REVOLUT_ACCOUNT_ID=your_account_id

# SEPA
SEPA_CREDITOR_ID=your_creditor_id
SEPA_BANK_API=https://bank.example/sepa

# Storage paths
DOCUMENT_STORAGE=storage/documents
EINVOICE_PATH=storage/einvoices
# Enable or disable open registration (true/false)
OPEN_REGISTRATION=false
# Payment provider to use for mock payments (paypal/sumup/revolut/bank)
PAYMENT_PROVIDER=paypal

# OpenBanking (OAuth2)
# Register your PSU-facing OAuth client with your banking partner and set the
# authorized redirect URI to the callback endpoint the app exposes, e.g.
#   http://localhost:5000/bank/callback
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
OPENBANKING_AUTH_URL=https://bank.example/oauth/authorize
OPENBANKING_TOKEN_URL=https://bank.example/oauth/token
OPENBANKING_API_BASE=https://api.bank.example
OPENBANKING_REDIRECT_URI=http://localhost:5000/bank/callback
OPENBANKING_SCOPE=accounts payments


### Advertising / SEM OAuth configuration
# Google Ads (OAuth2)
# Register an OAuth client in Google Cloud Console and set the redirect URI to:
#   http://localhost:5000/sem/ads/callback
# Or use your deployed host (must match exactly the registered redirect URI).
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_REDIRECT_URI=http://localhost:5000/sem/ads/callback
# Optional: requested scopes (provider-specific)
GOOGLE_ADS_SCOPE=https://www.googleapis.com/auth/adwords

# Facebook / Meta Ads
FACEBOOK_AD_CLIENT_ID=your_facebook_app_id
FACEBOOK_AD_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_AD_REDIRECT_URI=http://localhost:5000/sem/ads/callback

# Instagram (if separate) and LinkedIn
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Token storage (per-tenant). The app stores provider tokens by default under
# `storage/tenants/<tenant>/ads/<provider>_token.json`. You can override the
# global default below (for single-tenant testing) but per-tenant storage is
# recommended for multi-tenant deployments.
ADS_TOKEN_DEFAULT_PATH=storage/google_ads_token.json

# Path where tenant-specific data is stored (used by tenant management).
TENANTS_STORAGE_DIR=storage/tenants

# Security note: in production, do NOT commit client secrets into source control.
# Use a secrets manager (HashiCorp Vault, AWS Secrets Manager, etc.) and ensure
# redirect URIs and callback endpoints are registered correctly with providers.

# Optional: symmetric key for encrypting provider tokens on disk.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set this env var in your deployment environment. If unset, token files will be stored plaintext.
ADS_ENCRYPTION_KEY=
