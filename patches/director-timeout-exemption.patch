--- /dev/null
+++ b/tests/test_intelligence_director_timeout_exemption.py
@@ -0,0 +1,13 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_intelligence_director_is_exempt_from_global_request_timeout():
+    app_text = (ROOT / 'app.py').read_text(encoding='utf-8')
+    start = app_text.index('_TIMEOUT_EXEMPT_PREFIXES = (')
+    end = app_text.index('class _RequestTimeoutMiddleware', start)
+    timeout_exempt_block = app_text[start:end]
+
+    assert '"/api/intelligence-director"' in timeout_exempt_block
