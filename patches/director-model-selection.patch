+function _syncDirectorModelSelect(preferredModel = '') {
+  const endpointSelect = document.getElementById('intelligence-director-endpoint');
+  const modelSelect = document.getElementById('intelligence-director-model-select');
+  const summary = document.getElementById('intelligence-director-model');
+  if (!endpointSelect || !modelSelect) return;
+
+  const entry = _modelOptions.find(item => item.endpoint_id === endpointSelect.value);
+  const models = entry?.models || [];
+  modelSelect.innerHTML = models.length
+    ? models.map(model => `<option value="${_escape(model)}">${_escape(model)}</option>`).join('')
+    : '<option value="">No models available</option>';
+
+  if (preferredModel && models.includes(preferredModel)) modelSelect.value = preferredModel;
+  if (summary) {
+    const endpointName = entry?.endpoint_name || endpointSelect.value || 'endpoint unavailable';
+    summary.textContent = modelSelect.value ? `${modelSelect.value} · ${endpointName}` : 'Director model unavailable';
+  }
