--- /dev/null
+++ b/tests/test_director_model_selection_feature.py
@@ -0,0 +1,38 @@
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+sys.path.insert(0, str(ROOT))
+
+
+def _models_module():
+    from src.research.director import models
+    return models
+
+
+def test_mission_input_accepts_per_mission_director_selection():
+    models = _models_module()
+    mission = models.MissionInput(
+        objective='Map Example GmbH',
+        director_endpoint_id='ep2',
+        director_model='Qwen3.5-4B',
+    )
+    assert mission.director_endpoint_id == 'ep2'
+    assert mission.director_model == 'Qwen3.5-4B'
+
+
+def test_route_uses_requested_selection_before_config_fallback():
+    text = (ROOT / 'routes' / 'intelligence_director_routes.py').read_text(encoding='utf-8')
+    assert 'configured_endpoint_id=body.director_endpoint_id or cfg.endpoint_id' in text
+    assert 'configured_model=body.director_model or cfg.model' in text
+    assert "'model_options': _director_model_options(db, owner)" in text
+
+
+def test_frontend_renders_and_submits_director_model_selection():
+    text = (ROOT / 'static' / 'js' / 'intelligenceDirector.js').read_text(encoding='utf-8')
+    assert 'id="intelligence-director-endpoint"' in text
+    assert 'id="intelligence-director-model-select"' in text
+    assert 'director_endpoint_id:' in text
+    assert 'director_model:' in text
